# Server Configuration
PORT=8080
HOST=0.0.0.0
RUST_LOG=home_iot_backend=info,tower_http=debug

# PostgreSQL / TimescaleDB Connection
DATABASE_URL=postgres://iot_admin:iot_secret_password@localhost:5432/home_iot_db

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=home_iot_backend_service
MQTT_TELEMETRY_TOPIC=home/sensors/telemetry
MQTT_COMMAND_TOPIC=home/actuators/control

# ESP32 Direct HTTP Fallback
ESP_DIRECT_HTTP_URL=http://192.168.100.76
