# ==============================================================================
# HOME IOT SERVICE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and adjust your personal credentials.
# DO NOT commit '.env' containing real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & PORT BINDINGS
# ------------------------------------------------------------------------------
DASHBOARD_PORT=3000
EDGE_PORT=8080
BUSINESS_PORT=8081

# ------------------------------------------------------------------------------
# 2. DATABASE & REDIS CREDENTIALS
# ------------------------------------------------------------------------------
POSTGRES_USER=iot_admin
POSTGRES_PASSWORD=your_strong_database_password_here
POSTGRES_DB=home_iot_db
REDIS_PASSWORD=your_strong_redis_password_here

# ------------------------------------------------------------------------------
# 3. INTERNAL SERVICE & ADMINISTRATIVE KEYS
# ------------------------------------------------------------------------------
IOT_ADMIN_KEY=your_secure_admin_secret_key_here

# ------------------------------------------------------------------------------
# 4. NOTIFICATION DISPATCHER (Telegram & Discord Alerts)
# Leave blank to run in safe No-Op mode (logged to console only).
# ------------------------------------------------------------------------------
# Telegram Bot: Dapatkan token dari @BotFather dan chat ID dari @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook: Dapatkan dari Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. REMOTE ACCESS (DuckDNS Dynamic DNS) - Optional
# ------------------------------------------------------------------------------
DUCKDNS_SUBDOMAINS=your_duckdns_subdomain
DUCKDNS_TOKEN=your_duckdns_token_uuid

# ------------------------------------------------------------------------------
# 5. BUSINESS RULES & PLN TARIFF CONFIGURATION
# ------------------------------------------------------------------------------
PLN_LIMIT_WATTS=900.0
PLN_WARNING_THRESHOLD_WATTS=860.0
GAS_PPM_THRESHOLD=300
PLN_TARIFF_PER_KWH=1352.0

# ------------------------------------------------------------------------------
# 6. HARDWARE & ESP32 CONFIGURATION REFERENCE
# (Used when flashing firmware or synchronizing network details)
# ------------------------------------------------------------------------------
WIFI_SSID=Your_Home_WiFi_SSID
WIFI_PASSWORD=Your_WiFi_Password
MQTT_BROKER_IP=192.168.1.100

